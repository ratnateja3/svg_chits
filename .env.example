# Shri Vijaya Ganapathi Chit Fund Pvt Ltd
# Environment Configuration Template

# Site URL (Canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosted Form Provider Endpoint (e.g. Formspree, Formkeep, Basin, Web3Forms, etc.)
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your_form_id
NEXT_PUBLIC_FORM_ENDPOINT=

# Search Engine Indexing Control (Default: false)
# Set to 'true' only when ready for public search indexing in production
SITE_INDEXABLE=false

# Analytics (Optional)
# Provide GA4 Measurement ID (e.g. G-XXXXXXXXXX) to enable tracking
NEXT_PUBLIC_GA_ID=
