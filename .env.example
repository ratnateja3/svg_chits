# Shri Vijaya Ganapathi Chit Fund Pvt Ltd
# Environment Configuration Template

# Site URL (Canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sheets Lead Capture Webhook (Google Apps Script Web App URL)
# Keep this variable strictly server-side (DO NOT prefix with NEXT_PUBLIC_)
# Format: https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional dedicated webhook for Careers Applications (if left blank, defaults to GOOGLE_SHEETS_WEBHOOK_URL)
GOOGLE_CAREERS_WEBHOOK_URL=

# Search Engine Indexing Control (Default: false)
# Set to 'true' only when ready for public search indexing in production
SITE_INDEXABLE=false

# Analytics (Optional)
# Provide GA4 Measurement ID (e.g. G-XXXXXXXXXX) to enable tracking
NEXT_PUBLIC_GA_ID=
